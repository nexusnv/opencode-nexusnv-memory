{
  "name": "opencode-nexusnv-memory",
  "version": "0.2.0",
  "description": "Local-first, zero-subscription, zero-daemon, zero-embeddings memory for OpenCode V2. Git-backed markdown is the source of truth; hooks are passive and budget-capped; curation is human-approved.",
  "type": "module",
  "license": "MIT",
  "author": "nexusnv",
  "homepage": "https://github.com/nexusnv/opencode-nexusnv-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexusnv/opencode-nexusnv-memory.git"
  },
  "bugs": {
    "url": "https://github.com/nexusnv/opencode-nexusnv-memory/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "ai-agent",
    "markdown"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "agents/",
    "commands/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.29"
  },
  "peerDependencies": {
    "@opencode/theme": "2.0.29",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1"
  },
  "devDependencies": {
    "@opencode/schema": "2.0.29",
    "@opencode/theme": "2.0.29",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.9.10",
    "solid-js": "1.9.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
